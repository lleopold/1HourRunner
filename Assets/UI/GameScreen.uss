/* Add weapon display styling */
#lab_weapon_name {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    padding: 5px 10px;
    position: absolute;
    bottom: 80px;
    left: 20px;
    transition-duration: 0.3s;
}

#lab_weapon_slot {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    position: absolute;
    bottom: 110px;
    left: 20px;
}

.weapon-switched {
    scale: 1.2;
    color: yellow;
}