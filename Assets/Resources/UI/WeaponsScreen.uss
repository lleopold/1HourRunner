#ws_preview {
    background-image: resource('UI/checker_dark');
    background-size: 32px 32px;
    background-repeat: repeat;
    background-position: 0 0;
}

/* ── Back button — absolute top-left ────────────────────── */
.btn-back {
    position: absolute;
    top: 8px;
    left: 8px;
    height: 36px;
    padding: 0 16px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0,0,0,0);
    background-color: rgba(0,0,0,0);
    background-image: none;
    color: #5A6473;
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: color, border-left-width, border-left-color, background-color;
    transition-duration: 0.15s, 0.15s, 0.15s, 0.15s;
}

.btn-back:hover {
    background-color: rgba(94,225,165,0.06);
    color: #5EE1A5;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.btn-back:active {
    background-color: rgba(94,225,165,0.12);
    color: #FFFFFF;
}

/* ── Action button (Choose Level) — below weapon list ────── */
.btn-action {
    height: 40px;
    margin-top: 8px;
    padding: 0 20px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0,0,0,0);
    background-color: rgba(0,0,0,0);
    background-image: none;
    color: #B0BCCC;
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: background-color, color, border-left-width, border-left-color, translate;
    transition-duration: 0.1s, 0.1s, 0.1s, 0.1s, 0.1s;
}

.btn-action:hover {
    background-color: rgba(255,255,255,0.06);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
    translate: 4px 0;
}

.btn-action:active {
    background-color: rgba(94,225,165,0.1);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}
