#ws_preview {
    background-image: resource('UI/checker_dark');
    background-size: 32px 32px;
    background-repeat: repeat;
    background-position: 0 0;
}

/* ── Back button — absolute top-left ────────────────────── */
.btn-back {
    position: absolute;
    top: 8px;
    left: 8px;
    height: 36px;
    padding: 0 16px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0,0,0,0);
    background-color: rgba(0,0,0,0);
    background-image: none;
    color: #5A6473;
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: color, border-left-width, border-left-color, background-color;
    transition-duration: 0.15s, 0.15s, 0.15s, 0.15s;
}

.btn-back:hover {
    background-color: rgba(94,225,165,0.06);
    color: #5EE1A5;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.btn-back:active {
    background-color: rgba(94,225,165,0.12);
    color: #FFFFFF;
}

/* ── Action button (Choose Level) — below weapon list ────── */
.btn-action {
    height: 40px;
    margin-top: 8px;
    padding: 0 20px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0,0,0,0);
    background-color: rgba(0,0,0,0);
    background-image: none;
    color: #B0BCCC;
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: background-color, color, border-left-width, border-left-color, translate;
    transition-duration: 0.1s, 0.1s, 0.1s, 0.1s, 0.1s;
}

.btn-action:hover {
    background-color: rgba(255,255,255,0.06);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
    translate: 4px 0;
}

.btn-action:active {
    background-color: rgba(94,225,165,0.1);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

/* ── Accent bar (top of screen) ─────────────────────────── */
.ws-accent-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background-color: #5EE1A5;
}

/* ── Stats panel (right column) ─────────────────────────── */
.ws-stats {
    flex-shrink: 0;
    flex-grow: 0;
    width: 280px;
    padding: 12px 16px;
    background-color: rgba(255,255,255,0.03);
    border-width: 1px;
    border-color: rgba(255,255,255,0.08);
}

/* Hide scrollbars on the stats ScrollView */
.ws-stats > #unity-low-button,
.ws-stats > #unity-high-button,
.ws-stats #unity-vertical-scroller,
.ws-stats #unity-horizontal-scroller { display: none; }

/* ── Stat row ────────────────────────────────────────────── */
.stat-row {
    flex-direction: column;
    padding: 5px 4px 6px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.06);
    gap: 4px;
}

.stat-row:last-child { border-bottom-width: 0; }

.stat-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.stat-name {
    color: #5A6473;
    font-size: 12px;
    letter-spacing: 1px;
}

/* Read-only float value */
.stat-num {
    width: 64px;
    min-width: 64px;
}

.stat-num > .unity-base-field__label { display: none; }

.stat-num > .unity-base-field__input {
    background-color: rgba(255,255,255,0.04);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(255,255,255,0.08);
    color: #E5ECF7;
    font-size: 12px;
    -unity-font-style: bold;
    padding: 2px 5px;
    -unity-text-align: middle-right;
}

/* ── Progress bar ────────────────────────────────────────── */
.stat-bar-track {
    height: 2px;
    background-color: rgba(255,255,255,0.07);
    border-radius: 1px;
    margin: 0 2px;
}

.stat-bar-fill {
    height: 2px;
    background-color: #5EE1A5;
    border-radius: 1px;
    opacity: 0.6;
    width: 0%;
}
