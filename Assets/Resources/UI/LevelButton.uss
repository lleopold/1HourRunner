/* === Level Button — mirrors weapon-btn exactly === */

.level-btn {
    width: 100%;
    height: 80px;
    min-height: 80px;
    max-height: 80px;
    margin-bottom: 8px;
    padding: 0;
    background-color: rgba(40,40,40,0.75);
    border-top-width: 1px;
    border-top-color: rgba(255,255,255,0.06);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.06);
    position: relative;
    overflow: hidden;
}

.level-btn__topbar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 22px;
    background-color: rgba(8,8,8,0.92);
}

.level-btn__tl {
    position: absolute;
    left: 10px;
    top: 3px;
    font-size: 9px;
    letter-spacing: 1px;
    color: #B0B0B0;
    picking-mode: ignore;
}

.level-btn__tr {
    position: absolute;
    right: 12px;
    top: 3px;
    font-size: 9px;
    color: #B0B0B0;
    -unity-text-align: right;
    picking-mode: ignore;
}

.level-btn__name {
    position: absolute;
    left: 8px;
    bottom: 4px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: #EDEDED;
    picking-mode: ignore;
}

.level-btn__br {
    position: absolute;
    right: 8px;
    bottom: 4px;
    font-size: 9px;
    color: #9A9A9A;
    -unity-text-align: right;
    picking-mode: ignore;
}

.level-btn:hover {
    background-color: rgba(255,255,255,0.08);
}

.level-btn.is-active {
    background-color: rgba(255,255,255,0.12);
}

.level-btn__accent-line {
    position: absolute;
    right: 0;
    top: 22px;
    width: 3px;
    height: 56px;
    background-color: rgba(94,225,165,1);
    border-radius: 2px;
    opacity: 0;
}

.level-btn__hover-line {
    position: absolute;
    left: 0;
    top: 50%;
    translate: 0 -50%;
    width: 3px;
    height: 40%;
    background-color: rgba(94,225,165,0);
    border-radius: 2px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.level-btn:hover .level-btn__hover-line {
    background-color: rgba(94,225,165,0.85);
}

.level-btn.is-active .level-btn__hover-line {
    background-color: rgba(94,225,165,0);
}
