/* Base text-style tab */
.tab {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-radius: 0;
    padding: 6px 10px;
    color: rgba(176,188,204,0.6);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    font-size: 13px;
    letter-spacing: 1.5px;
    opacity: 1;
    transition-property: color, translate, border-bottom-color;
    transition-duration: 0.15s;
}

.tab:hover {
    color: rgba(255,255,255,0.9);
    translate: 0 -1px;
}

/* Active tab — underline indicator, color pulsed via C# inline style */
.tab.is-active {
    color: rgba(255,255,255,1);
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: rgba(94,225,165,1);
    padding-bottom: 4px;
}

/* Side tabs get subtly dimmed */
.tab.is-side { opacity: 0.7; }

/* Hidden when beyond window */
.tab.is-hidden { visibility: hidden; }

/* Container */
#ws_tabs {
    margin-top: 24px;
    margin-left: 24px;
    overflow: visible;
}
