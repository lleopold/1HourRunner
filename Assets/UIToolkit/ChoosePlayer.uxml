<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIToolkit/ChoosePlayer.uss?fileID=7433441132597879392&amp;guid=82b70eb753ffc5e479eabab8fd538c88&amp;type=3#ChoosePlayer"/>
    <ui:VisualElement class="choose-root">
        <ui:VisualElement class="accent-bar"/>
        <ui:VisualElement class="topbar">
            <ui:Button name="btn_back" text="← BACK" class="btn btn-back"/>
            <ui:Label text="1 Hour Runner" class="title"/>
            <ui:VisualElement style="flex-direction: row; gap: 8px;"/>
        </ui:VisualElement>
        <ui:VisualElement class="row">
            <!-- ── Left column: character list + loadout ─────────────── -->
            <ui:VisualElement class="thumbs-col">
                <ui:ScrollView name="choose_char" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="thumbs">
                    <ui:Button name="btn_jennifer" text="Jennifer" class="thumb"/>
                    <ui:Button name="btn_swat" text="Swat" class="thumb"/>
                    <ui:Button name="btn_steel" text="Steel" class="thumb"/>
                    <ui:Button name="btn_business_girl" text="Business girl" class="thumb"/>
                    <ui:Button name="btn_dr" text="Dr" class="thumb"/>
                    <ui:Button name="btn_green_hat" text="Green Hat" class="thumb"/>
                </ui:ScrollView>
                <ui:Button name="btn_choose_weapon" text="CHOOSE WEAPON" class="btn-level-up btn-choose-weapon"/>
                <ui:VisualElement class="loadout-box">
                    <ui:Label text="LOADOUT" class="loadout-label"/>
                    <ui:IntegerField name="int_weapon" label="Weapon slot" class="weapon-field"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ── Centre: 3D character preview ──────────────────────── -->
            <ui:VisualElement name="visual_rep" class="preview"/>

            <!-- ── Right: stats panel (tabbed + dynamic) ─────────────── -->
            <ui:VisualElement name="stats" class="stats">
                <ui:VisualElement class="stat-tabs">
                    <ui:Button name="tab_movement" text="MOVEMENT" class="stat-tab is-tab-active"/>
                    <ui:Button name="tab_combat" text="COMBAT" class="stat-tab"/>
                    <ui:Button name="tab_survival" text="SURVIVAL" class="stat-tab"/>
                </ui:VisualElement>

                <ui:VisualElement class="points-bar">
                    <ui:Label text="EXPERIENCE" class="points-label"/>
                    <ui:Label name="lbl_points" text="0" class="points-value"/>
                </ui:VisualElement>

                <!-- Stat rows injected here by UIT_ChoosePlayer -->
                <ui:VisualElement name="stats_container" class="stats-container"/>

                <ui:VisualElement class="perk-section">
                    <ui:VisualElement class="perk-header">
                        <ui:Label text="PERK" class="perk-header-label"/>
                        <ui:Label name="lbl_perk_name" text="—" class="perk-name"/>
                    </ui:VisualElement>
                    <ui:Label name="lbl_perk_desc" text="" class="perk-desc"/>
                </ui:VisualElement>

                <ui:Button name="btn_level_up" text="LEVEL UP" enabled="false" class="btn-level-up"/>
                <ui:Button name="btn_reset" text="RESET (−20%)" class="btn-reset"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
