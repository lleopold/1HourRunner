/* ============================================================
   ChoosePlayer — styled in the spirit of the Start scene
   ============================================================ */

/* Full-screen dark root — transparent so the 3D scene shows through */
.choose-root {
    flex-grow: 1;
    flex-direction: column;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: transparent;
    padding: 0 24px 16px 24px;
}

/* ── Top bar ─────────────────────────────────────────────── */
.topbar {
    height: 56px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.07);
    margin-bottom: 16px;
    padding: 0 4px;
}

.title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 4px;
}

/* Accent on first letter of title (visual only — green accent bar below) */
.accent-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background-color: #5EE1A5;
}

/* ── Navigation button (top-right) ───────────────────────── */
.btn {
    height: 40px;
    padding: 0 20px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0,0,0,0);
    background-color: rgba(0,0,0,0);
    color: #B0BCCC;
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: background-color, color, border-left-width, border-left-color;
    transition-duration: 0.1s, 0.1s, 0.1s, 0.1s;
}

.btn:hover {
    background-color: rgba(255,255,255,0.06);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.btn:active {
    background-color: rgba(94,225,165,0.1);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

/* ── Main row ────────────────────────────────────────────── */
.row {
    flex-direction: row;
    align-items: stretch;
    gap: 16px;
    flex-grow: 1;
}

/* ── Character list panel ────────────────────────────────── */
#choose_char {
    width: 18%;
    min-width: 160px;
    max-width: 280px;
    padding: 10px;
    background-color: rgba(255,255,255,0.03);
    border-width: 1px;
    border-color: rgba(255,255,255,0.08);
}

.thumb {
    height: 80px;
    margin-bottom: 8px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0,0,0,0);
    background-color: rgba(255,255,255,0.05);
    color: #B0BCCC;
    font-size: 13px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    transition-property: background-color, color, border-left-width, border-left-color;
    transition-duration: 0.1s;
}

.thumb:hover {
    background-color: rgba(255,255,255,0.08);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.thumb:active {
    background-color: rgba(94,225,165,0.1);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

/* Selected state */
.thumb.is-active {
    background-color: rgba(255,255,255,0.1);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

/* Right accent line — injected via C#, pulsed via style.opacity */
.thumb__accent-line {
    position: absolute;
    right: 0;
    top: 20%;
    width: 3px;
    height: 60%;
    background-color: rgba(94,225,165,1);
    border-radius: 2px;
    opacity: 0;
}

/* ── Preview panel (centre) ──────────────────────────────── */
#visual_rep {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 35%;
    align-self: stretch;
    background-color: transparent;
    border-width: 0;
    picking-mode: ignore;
}

/* ── Stats panel ─────────────────────────────────────────── */
.stats {
    width: 28%;
    min-width: 260px;
    max-width: 480px;
    padding: 12px 16px;
    background-color: rgba(255,255,255,0.03);
    border-width: 1px;
    border-color: rgba(255,255,255,0.08);
    gap: 4px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 5px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.06);
}

.stat-row:last-child { border-bottom-width: 0; }

.stat-name {
    color: #5A6473;
    font-size: 13px;
    letter-spacing: 1px;
}

.stat-val {
    color: #E5ECF7;
    font-size: 13px;
    -unity-font-style: bold;
    pointer-events: none;
}

/* ── Stepper controls ────────────────────────────────────── */
.stat-edit { flex-direction: row; align-items: center; gap: 6px; }

.step {
    width: 22px;
    height: 22px;
    padding: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    background-color: rgba(255,255,255,0.05);
    color: #B0BCCC;
    -unity-text-align: middle-center;
    font-size: 14px;
    transition-property: background-color, color;
    transition-duration: 0.1s;
}

.step:hover {
    background-color: rgba(94,225,165,0.15);
    color: #5EE1A5;
    border-color: #5EE1A5;
}

.step:active {
    background-color: rgba(94,225,165,0.25);
    color: #5EE1A5;
}

.num { width: 90px; min-width: 90px; }

/* Numeric field input box */
.num > .unity-base-field__input {
    background-color: rgba(255,255,255,0.06);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    color: #E5ECF7;
    padding: 4px 6px;
}

.num:focus-within > .unity-base-field__input {
    border-color: #5EE1A5;
    background-color: rgba(94,225,165,0.06);
}

/* ── Scrollbar styling ───────────────────────────────────── */
#choose_char .unity-scroll-view__horizontal-scroller { display: none; height: 0; }
#choose_char .unity-scroller__low-button,
#choose_char .unity-scroller__high-button { display: none; }
#choose_char .unity-scroll-view__vertical-scroller { width: 4px; margin-right: 2px; background-color: transparent; }
#choose_char .unity-scroller__slider .unity-slider__tracker { background-color: rgba(255,255,255,0.06); }
#choose_char .unity-scroller__slider .unity-slider__dragger { background-color: rgba(255,255,255,0.25); min-height: 28px; }

/* ── Bottom bar ──────────────────────────────────────────── */
.bottom {
    height: 48px;
    align-items: flex-start;
    justify-content: center;
    border-top-width: 1px;
    border-top-color: rgba(255,255,255,0.07);
    margin-top: 8px;
    padding-top: 8px;
}

.weapon-field > .unity-base-field__input {
    background-color: rgba(255,255,255,0.06);
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    color: #E5ECF7;
}

.weapon-field:focus-within > .unity-base-field__input {
    border-color: #5EE1A5;
}

/* ── Thumb perk label (injected via C#) ─────────────────── */
.thumb__perk {
    position: absolute;
    bottom: 6px;
    left: 0;
    right: 0;
    font-size: 9px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: #5EE1A5;
    -unity-text-align: middle-center;
    opacity: 0.75;
}

/* ── Perk section (inside stats panel) ──────────────────── */
.perk-section {
    margin-top: 10px;
    padding: 10px 4px 6px 4px;
    border-top-width: 1px;
    border-top-color: rgba(94,225,165,0.2);
    gap: 6px;
}

.perk-header {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.perk-header-label {
    font-size: 9px;
    letter-spacing: 3px;
    color: #5EE1A5;
    -unity-font-style: bold;
    opacity: 0.6;
}

.perk-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: #5EE1A5;
    letter-spacing: 2px;
}

.perk-desc {
    font-size: 11px;
    color: #5A6473;
    -unity-text-align: upper-left;
    padding: 0 2px;
    white-space: normal;
}

/* ── Level Up button ─────────────────────────────────────── */
.btn-level-up {
    margin-top: 14px;
    height: 40px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(94,225,165,0.3);
    background-color: rgba(94,225,165,0.06);
    color: #5EE1A5;
    font-size: 13px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0.4;
}
