/* ============================================================
   ChoosePlayer — styled in the spirit of the Start scene
   ============================================================ */

/* Full-screen dark root — transparent so the 3D scene shows through */
.choose-root {
    flex-grow: 1;
    flex-direction: column;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: transparent;
    padding: 0 24px 16px 24px;
}

/* ── Top bar ─────────────────────────────────────────────── */
.topbar {
    height: 56px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.07);
    margin-bottom: 16px;
    padding: 0 4px;
}

.title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 4px;
}

/* Accent on first letter of title (visual only — green accent bar below) */
.accent-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background-color: #5EE1A5;
}

/* ── Navigation button (top-right) ───────────────────────── */
.btn {
    height: 40px;
    padding: 0 20px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0,0,0,0);
    background-color: rgba(0,0,0,0);
    color: #B0BCCC;
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: background-color, color, border-left-width, border-left-color;
    transition-duration: 0.1s, 0.1s, 0.1s, 0.1s;
}

.btn:hover {
    background-color: rgba(255,255,255,0.06);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.btn:active {
    background-color: rgba(94,225,165,0.1);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

/* ── Back button ─────────────────────────────────────────── */
.btn-back {
    letter-spacing: 2px;
    font-size: 12px;
    color: #5A6473;
    padding: 0 16px;
    transition-property: color, border-left-width, border-left-color, background-color;
    transition-duration: 0.15s, 0.15s, 0.15s, 0.15s;
}

.btn-back:hover {
    color: #5EE1A5;
    background-color: rgba(94,225,165,0.06);
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.btn-back:active {
    color: #FFFFFF;
    background-color: rgba(94,225,165,0.12);
}

/* ── Main row ────────────────────────────────────────────── */
.row {
    flex-direction: row;
    align-items: stretch;
    gap: 16px;
    flex-grow: 1;
}

/* ── Character list panel ────────────────────────────────── */
#choose_char {
    width: 100%;
    min-width: 0;
    max-width: none;
    padding: 10px 14px 10px 10px;
    background-color: rgba(255,255,255,0.03);
    border-width: 1px;
    border-color: rgba(255,255,255,0.08);
    overflow: visible;
}

#choose_char > #unity-low-button,
#choose_char > #unity-high-button,
#choose_char #unity-vertical-scroller,
#choose_char #unity-horizontal-scroller,
#choose_char #unity-slider,
#choose_char .unity-scroller,
#choose_char .unity-scroll-view__vertical-scroller,
#choose_char .unity-scroll-view__horizontal-scroller {
    display: none;
}

.thumb {
    height: 80px;
    width: 100%;
    margin-bottom: 8px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0,0,0,0);
    background-color: rgba(255,255,255,0.05);
    color: #B0BCCC;
    font-size: 13px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    overflow: visible;
    transition-property: background-color, color, border-left-width, border-left-color;
    transition-duration: 0.1s;
}

.thumb:hover {
    background-color: rgba(255,255,255,0.08);
    color: #FFFFFF;
}

.thumb:active {
    background-color: rgba(94,225,165,0.1);
    color: #FFFFFF;
}

/* Selected state */
.thumb.is-active {
    background-color: rgba(255,255,255,0.1);
    color: #FFFFFF;
}

/* Right accent line — visible only when selected, pulsed via C# */
.thumb__accent-line {
    position: absolute;
    right: 4px;
    top: 24px;
    width: 4px;
    height: 36px;
    background-color: #5EE1A5;
    border-radius: 2px;
    opacity: 0;
}

/* Top dark strip — same as WeaponButton topbar */
.thumb__topbar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 22px;
    background-color: rgba(8,8,8,0.92);
}

/* Hover line — left side */
.thumb__hover-line {
    position: absolute;
    left: 0;
    top: 50%;
    translate: 0 -50%;
    width: 3px;
    height: 40%;
    background-color: rgba(94,225,165,0);
    border-radius: 2px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.thumb:hover .thumb__hover-line {
    background-color: rgba(94,225,165,0.85);
}

.thumb.is-active .thumb__hover-line {
    background-color: rgba(94,225,165,0);
}

/* ── Preview panel (centre) ──────────────────────────────── */
#visual_rep {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    align-self: stretch;
    background-color: transparent;
    border-width: 0;
    picking-mode: ignore;
}

/* ── Stats panel ─────────────────────────────────────────── */
.stats {
    flex-shrink: 0;
    flex-grow: 0;
    flex-basis: 520px;
    padding: 12px 16px;
    background-color: rgba(255,255,255,0.03);
    border-width: 1px;
    border-color: rgba(255,255,255,0.08);
    gap: 4px;
}

.stat-row {
    flex-direction: column;
    padding: 5px 4px 6px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.06);
    gap: 4px;
}

.stat-row:last-child { border-bottom-width: 0; }

/* Top part of stat row — label left, edit right */
.stat-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* Stat progress bar track */
.stat-bar-track {
    height: 2px;
    background-color: rgba(255,255,255,0.07);
    border-radius: 1px;
    margin: 0 2px;
}

/* Stat progress bar fill */
.stat-bar-fill {
    height: 2px;
    background-color: #5EE1A5;
    border-radius: 1px;
    opacity: 0.55;
}

.stat-name {
    color: #5A6473;
    font-size: 13px;
    letter-spacing: 1px;
}

.stat-val {
    color: #E5ECF7;
    font-size: 13px;
    -unity-font-style: bold;
    pointer-events: none;
}

/* ── Stepper controls ────────────────────────────────────── */
.stat-edit { flex-direction: row; align-items: center; gap: 6px; }

.step {
    width: 22px;
    height: 22px;
    padding: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    background-color: rgba(255,255,255,0.05);
    color: #B0BCCC;
    -unity-text-align: middle-center;
    font-size: 14px;
    transition-property: background-color, color;
    transition-duration: 0.1s;
}

.step:hover {
    background-color: rgba(94,225,165,0.15);
    color: #5EE1A5;
    border-color: #5EE1A5;
}

.step:active {
    background-color: rgba(94,225,165,0.25);
    color: #5EE1A5;
}

.num { width: 90px; min-width: 90px; }

/* Numeric field input box */
.num > .unity-base-field__input {
    background-color: rgba(255,255,255,0.06);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    color: #E5ECF7;
    padding: 4px 6px;
}

.num:focus-within > .unity-base-field__input {
    border-color: #5EE1A5;
    background-color: rgba(94,225,165,0.06);
}

/* ── Scrollbar styling ───────────────────────────────────── */
#choose_char .unity-scroll-view__horizontal-scroller { display: none; height: 0; }
#choose_char .unity-scroller__low-button,
#choose_char .unity-scroller__high-button { display: none; }
#choose_char .unity-scroll-view__vertical-scroller { width: 4px; margin-right: 2px; background-color: transparent; }
#choose_char .unity-scroller__slider .unity-slider__tracker { background-color: rgba(255,255,255,0.06); }
#choose_char .unity-scroller__slider .unity-slider__dragger { background-color: rgba(255,255,255,0.25); min-height: 28px; }

/* ── Bottom bar ──────────────────────────────────────────── */
.bottom {
    height: 48px;
    align-items: flex-start;
    justify-content: center;
    border-top-width: 1px;
    border-top-color: rgba(255,255,255,0.07);
    margin-top: 8px;
    padding-top: 8px;
}

.weapon-field > .unity-base-field__input {
    background-color: rgba(255,255,255,0.06);
    border-width: 1px;
    border-color: rgba(255,255,255,0.1);
    color: #E5ECF7;
}

.weapon-field:focus-within > .unity-base-field__input {
    border-color: #5EE1A5;
}

/* ── Thumb labels (injected via C#) ─────────────────────── */
/* Perk name — top-left on the dark strip */
.thumb__perk {
    position: absolute;
    top: 3px;
    left: 8px;
    font-size: 9px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: #5EE1A5;
    -unity-text-align: upper-left;
    opacity: 0.85;
}

/* Progress bar track — sits just below the perk name */
.thumb__bar-track {
    position: absolute;
    left: 8px;
    right: 14px;
    top: 24px;
    height: 3px;
    background-color: rgba(255,255,255,0.08);
    border-radius: 2px;
}

/* Progress bar fill */
.thumb__bar-fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    background-color: #5EE1A5;
    border-radius: 2px;
    opacity: 0.7;
}

/* Bottom bar — dark strip with LVL label */
.thumb__bottombar {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 18px;
    background-color: rgba(8,8,8,0.75);
}

/* Level — right-aligned on bottom bar */
.thumb__level {
    position: absolute;
    bottom: 2px;
    right: 8px;
    font-size: 9px;
    color: #9A9A9A;
    -unity-text-align: right;
    letter-spacing: 1px;
}

/* ── Perk section (inside stats panel) ──────────────────── */
.perk-section {
    margin-top: 10px;
    padding: 10px 4px 6px 4px;
    border-top-width: 1px;
    border-top-color: rgba(94,225,165,0.2);
    gap: 6px;
}

.perk-header {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.perk-header-label {
    font-size: 9px;
    letter-spacing: 3px;
    color: #5EE1A5;
    -unity-font-style: bold;
    opacity: 0.6;
}

.perk-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: #5EE1A5;
    letter-spacing: 2px;
}

.perk-desc {
    font-size: 11px;
    color: #5A6473;
    -unity-text-align: upper-left;
    padding: 0 2px;
    white-space: normal;
}

/* ── Level Up button ─────────────────────────────────────── */
.btn-level-up {
    margin-top: auto;
    height: 40px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(94,225,165,0.3);
    background-color: rgba(94,225,165,0.06);
    background-image: none;
    color: #5EE1A5;
    font-size: 13px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0.4;
}

.btn-choose-weapon {
    margin-top: auto;
    opacity: 1;
    background-color: rgba(94,225,165,0.06);
    border-color: rgba(94,225,165,0.3);
    border-width: 1px;
    border-radius: 0;
    -unity-background-image-tint-color: rgba(0,0,0,0);
}

.btn-choose-weapon:hover {
    background-color: rgba(94,225,165,0.14);
    border-color: rgba(94,225,165,0.6);
}

.thumbs-col {
    flex-direction: column;
    flex-shrink: 0;
    flex-grow: 0;
    flex-basis: 347px;
}

.thumbs {
    flex-grow: 1;
    flex-shrink: 1;
}
