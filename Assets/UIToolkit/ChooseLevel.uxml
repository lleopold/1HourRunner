<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIToolkit/ChooseLevel.uss?fileID=7433441132597879392&amp;guid=a622e1076cecd6f499f2868bff6e9ca8&amp;type=3#ChooseLevel" />
    <ui:VisualElement class="choose-root">
        <ui:VisualElement class="accent-bar" />
        <ui:VisualElement class="topbar">
            <ui:Button name="btn_back" text="← BACK" class="btn btn-back" />
            <ui:Label text="1 Hour Runner" class="title" />
            <ui:VisualElement style="flex-direction: row; gap: 8px;" />
        </ui:VisualElement>
        <ui:VisualElement class="row">
            <!-- Left column: level list -->
            <ui:VisualElement class="thumbs-col">
                <ui:ScrollView name="levels-list" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="thumbs" />
                <ui:Button name="btn_play_level" text="PLAY LEVEL" class="btn-play-level" />
            </ui:VisualElement>
            <!-- Centre: preview image -->
            <ui:VisualElement name="preview-area" class="preview-area">
                <ui:Image name="preview-image" class="preview-image" />
                <ui:VisualElement name="preview-rt-surface" />
            </ui:VisualElement>
            <!-- Right: level info panel -->
            <ui:VisualElement class="info-panel">
                <ui:Label text="LEVEL" class="info-section-label" />
                <ui:Label name="preview-title" text="—" class="info-title" />
                <ui:VisualElement class="info-divider" />
                <ui:Label text="DESCRIPTION" class="info-section-label" />
                <ui:Label name="preview-desc" text="—" class="info-desc" />
                <ui:VisualElement class="info-divider" />
                <ui:Label text="DIFFICULTY" class="info-section-label" />
                <ui:VisualElement class="stat-bar-track">
                    <ui:VisualElement name="difficulty-bar" class="stat-bar-fill" />
                </ui:VisualElement>
                <ui:Label text="ENEMY DENSITY" class="info-section-label" style="margin-top: 10px;" />
                <ui:VisualElement class="stat-bar-track">
                    <ui:VisualElement name="density-bar" class="stat-bar-fill" />
                </ui:VisualElement>
                <ui:Label text="AREA SIZE" class="info-section-label" style="margin-top: 10px;" />
                <ui:VisualElement class="stat-bar-track">
                    <ui:VisualElement name="area-bar" class="stat-bar-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
