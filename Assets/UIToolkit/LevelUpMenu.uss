.levelup-panel {
    width: 70%;
    min-width: 720px;
    max-width: 1100px;
    margin: auto;
    padding: 16px 20px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(18, 20, 24, 0.88);
    border-radius: 16px;
    border-width: 1px;
    border-color: #2a2f38;
    gap: 12px;
}

.levelup-title {
    unity-font-style: bold;
    font-size: 22px;
    color: #e5e7eb;
    margin-bottom: 4px;
    -unity-text-outline-color: rgba(0,0,0,0.35);
    -unity-text-outline-width: 0.2;
}

.choices-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    gap: 12px;
}

.choice {
    flex-grow: 1;
    min-width: 0;
    height: 160px;
    padding: 10px;
    border-radius: 14px;
    border-width: 1px;
    border-color: #323844;
    background-color: #111318;
    transition-property: background-color, scale, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 8px;
}

.choice:hover,
.choice:focus {
    background-color: #171a21;
    border-color: #3b82f6;
    scale: 1.02;
}

.choice__icon {
    height: 80px;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit; /* keep aspect ratio */
    background-color: rgba(255,255,255,0.03);
    border-radius: 10px;
    border-width: 1px;
    border-color: #2b303a;
}

.choice__title {
    unity-font-style: bold;
    font-size: 14px;
    color: #e5e7eb;
}

.choice__desc {
    font-size: 12px;
    color: #9aa3b2;
    opacity: 0.95;
}

.actions-row {
    height: 44px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
}

.btn-primary, .btn-secondary {
    height: 100%;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 10px;
    border-width: 1px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.1s;
}

.btn-primary {
    background-color: #2563eb;
    border-color: #1e4fcc;
    color: white;
}
.btn-primary:hover, .btn-primary:focus {
    background-color: #1f4fd6;
    border-color: #193fb0;
    scale: 1.01;
}

.btn-secondary {
    background-color: #0f1116;
    border-color: #2a2f38;
    color: #e5e7eb;
}
.btn-secondary:hover, .btn-secondary:focus {
    background-color: #151922;
    border-color: #3b4452;
    scale: 1.01;
}

/* Responsive: allow wrapping if narrow */
@media (max-width: 820px) {
    .levelup-panel { width: 92%; min-width: 0; }
    .choices-row { flex-wrap: wrap; }
    .choice { flex-basis: calc(50% - 6px); }
}
/* ring around the picture only */
.choice__icon {
    border-width: 3px;
    border-color: rgba(255,255,255,0.08);
    border-radius: 10px;
}

/* rarities */
.ring-common    { border-color:#8c8c8c; }   /* gray  */
.ring-uncommon  { border-color:#1eff00; }   /* green */
.ring-rare      { border-color:#0070dd; }   /* blue  */
.ring-epic      { border-color:#a335ee; }   /* purple*/
.ring-legendary { border-color:#ffcc00; }   /* yellow*/

    .choice { cursor: pointer; }
.choice:active { scale: 0.99; }

