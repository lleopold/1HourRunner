/* Base bar geometry: thin + wide */
.bar {
    width: 100%;
    height: 9px;              /* thin */
    flex-grow: 0;
    flex-shrink: 0;
    margin: 8px 8px 8px 8px;        /* spacing between bars */
    padding: 0;
    border-width: 0;
    border-radius: 0;
}
.bar:last-child { margin-bottom: 0; }

/* Remove Unity defaults */
.bar .unity-progress-bar__title { display: none; }
.bar .unity-progress-bar__low   { display: none; }
.bar .unity-progress-bar__back  { display: none; }

/* Background track */
.bar .unity-progress-bar__background {
    background-color: rgb(24,28,32);
    border-width: 0;
    border-radius: 0;
}

/* Fill strip */
.bar .unity-progress-bar__progress {
    border-width: 0;
    border-radius: 0;
}

/* Colors */
#pb_health  .unity-progress-bar__progress { background-color: rgb(239,68,68); }   /* red */
#pb_stamina .unity-progress-bar__progress { background-color: rgb(250,204,21); }  /* yellow */
#pb_reload  .unity-progress-bar__progress { background-color: rgb(34,197,94); }   /* green */

/* XP full-width bottom */
#pb_xp { height: 4px; border-width: 0; }           /* was 16px */
#pb_xp .unity-progress-bar__background { background-color: rgb(16,20,24); }
#pb_xp .unity-progress-bar__progress   { background-color: rgb(96,165,250); }     /* blue */

/* Force inner Unity progress bar to match parent size */
#pb_health .unity-progress-bar,
#pb_stamina .unity-progress-bar,
#pb_reload .unity-progress-bar,
#pb_xp .unity-progress-bar {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

#pb_xp,
#pb_xp .unity-progress-bar__background,
#pb_xp .unity-progress-bar__progress {
    border-width: 0;
    border-color: transparent;
    border-radius: 0;
}