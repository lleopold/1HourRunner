/* ============================================================
   SCREEN ROOT — full canvas, background image
   ============================================================ */
.screen-root {
    flex-grow: 1;
    flex-direction: row;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/Resources/UI/Images/menu_background_1.png?fileID=2800000&guid=3f1c177006f59944aa899d5d8635d25c&type=3#menu_background_1");
    background-size: cover;
    background-position: center;
}

/* ============================================================
   LEFT PANEL — dark overlay so text stays readable
   ============================================================ */
.left-panel {
    width: 420px;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 0 0 60px 60px;
    background-color: rgba(5,7,10,0.78);
}

.accent-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background-color: #5EE1A5;
}

/* ============================================================
   TITLE BLOCK
   ============================================================ */
.title-block {
    margin-bottom: 48px;
}

.title-top {
    font-size: 52px;
    color: #FFFFFF;
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin: 0;
    padding: 0;
}

.title-bottom {
    font-size: 52px;
    color: #5EE1A5;
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-top: -10px;
    padding: 0;
}

.tagline {
    font-size: 13px;
    color: #5A6473;
    letter-spacing: 2px;
    margin-top: 8px;
    -unity-font-style: italic;
}

/* ============================================================
   NAV GROUP
   ============================================================ */
.nav-group {
    flex-direction: column;
    align-items: stretch;
    width: 260px;
}

/* ============================================================
   BUTTON — RE-style, all identical
   ============================================================ */
.btn {
    height: 44px;
    margin-bottom: 2px;
    padding: 0 0 0 16px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0,0,0,0);
    background-color: rgba(0,0,0,0);
    color: #B0BCCC;
    font-size: 15px;
    letter-spacing: 1px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    transition-property: background-color, color, border-left-width, border-left-color;
    transition-duration: 0.1s, 0.1s, 0.1s, 0.1s;
    transition-timing-function: ease, ease, ease, ease;
}

.btn:hover {
    background-color: rgba(255,255,255,0.06);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.btn:active {
    background-color: rgba(94,225,165,0.1);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.btn--primary {}
.btn--primary:hover {}
.btn--primary:active {}
.btn--secondary {}
.btn--secondary:hover {}
.btn--ghost {}
.btn--ghost:hover {}

/* ============================================================
   RIGHT PANEL — transparent, shows background image
   ============================================================ */
.right-panel {
    flex-grow: 1;
    background-color: rgba(0,0,0,0);
}

/* ============================================================
   VERSION LABEL
   ============================================================ */
.version-label {
    position: absolute;
    bottom: 16px;
    right: 20px;
    font-size: 11px;
    color: rgba(255,255,255,0.25);
    letter-spacing: 1px;
}
