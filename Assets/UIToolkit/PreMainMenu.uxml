<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements" editor="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

  <Style src="project://database/Assets/UIToolkit/PreMainMenuButtons.uss?fileID=7433441132597879392&amp;guid=b2e2ccd3e254a354780aaf3585b2ec95&amp;type=3#PreMainMenuButtons" />

  <!-- Full screen root -->
  <ui:VisualElement class="screen-root">

    <!-- LEFT PANEL: branding + navigation -->
    <ui:VisualElement class="left-panel">

      <!-- Accent bar top -->
      <ui:VisualElement class="accent-bar" />

      <!-- Game title block -->
      <ui:VisualElement class="title-block">
        <ui:Label text="1 HOUR" class="title-top" />
        <ui:Label text="RUNNER" class="title-bottom" />
        <ui:Label text="Survive as long as you can." class="tagline" />
      </ui:VisualElement>

      <!-- Navigation buttons -->
      <ui:VisualElement class="nav-group">
        <ui:Button text="PLAY"            name="btn_play"     class="btn btn--primary" />
        <ui:Button text="OPTIONS"         name="btn_options"  class="btn btn--secondary" />
        <ui:Button text="LANGUAGE"        name="btn_language" class="btn btn--secondary" />
        <ui:Button text="QUIT"            name="btn_quit"     class="btn btn--ghost" />
      </ui:VisualElement>

    </ui:VisualElement>

    <!-- RIGHT PANEL: empty, reserved for background art -->
    <ui:VisualElement class="right-panel" />

    <!-- Version label bottom-right -->
    <ui:Label text="v0.1.0" class="version-label" />

  </ui:VisualElement>
</ui:UXML>
