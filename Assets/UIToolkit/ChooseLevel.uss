/* ============================================================
   ChooseLevel -- RE/COD dark style, matches ChoosePlayer
   ============================================================ */

.choose-root {
    flex-grow: 1;
    flex-direction: column;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: transparent;
    padding: 0 24px 16px 24px;
}

.accent-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background-color: #5EE1A5;
}

.topbar {
    height: 56px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.07);
    margin-bottom: 16px;
    padding: 0 4px;
}

.title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 4px;
}

.btn {
    height: 40px;
    padding: 0 20px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0,0,0,0);
    background-color: rgba(0,0,0,0);
    background-image: none;
    color: #B0BCCC;
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: background-color, color, border-left-width, border-left-color;
    transition-duration: 0.1s, 0.1s, 0.1s, 0.1s;
}

.btn:hover {
    background-color: rgba(255,255,255,0.06);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.btn:active {
    background-color: rgba(94,225,165,0.1);
    color: #FFFFFF;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.btn-back {
    letter-spacing: 2px;
    font-size: 12px;
    color: #5A6473;
    padding: 0 16px;
    transition-property: color, border-left-width, border-left-color, background-color;
    transition-duration: 0.15s, 0.15s, 0.15s, 0.15s;
}

.btn-back:hover {
    color: #5EE1A5;
    background-color: rgba(94,225,165,0.06);
    border-left-width: 3px;
    border-left-color: #5EE1A5;
}

.btn-back:active {
    color: #FFFFFF;
    background-color: rgba(94,225,165,0.12);
}

.row {
    flex-direction: row;
    align-items: stretch;
    gap: 16px;
    flex-grow: 1;
}

.thumbs-col {
    flex-basis: 300px;
    flex-shrink: 0;
    flex-direction: column;
}

.thumbs {
    flex-grow: 1;
    width: 100%;
    padding: 10px 14px 10px 10px;
    background-color: rgba(255,255,255,0.03);
    border-width: 1px;
    border-color: rgba(255,255,255,0.08);
    overflow: visible;
}

.thumbs > #unity-low-button,
.thumbs > #unity-high-button,
.thumbs #unity-vertical-scroller,
.thumbs #unity-horizontal-scroller,
.thumbs #unity-slider,
.thumbs .unity-scroller,
.thumbs .unity-scroll-view__vertical-scroller,
.thumbs .unity-scroll-view__horizontal-scroller {
    display: none;
}

.btn-play-level {
    height: 44px;
    margin-top: 12px;
    border-radius: 0;
    border-width: 0;
    border-left-width: 3px;
    border-left-color: #5EE1A5;
    background-color: rgba(94,225,165,0.08);
    background-image: none;
    color: #5EE1A5;
    font-size: 13px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, color, border-left-color;
    transition-duration: 0.15s;
    opacity: 1;
}

.btn-play-level:hover {
    background-color: rgba(94,225,165,0.18);
    color: #FFFFFF;
    border-left-color: #FFFFFF;
}

.btn-play-level:active {
    background-color: rgba(94,225,165,0.28);
    color: #FFFFFF;
}

.preview-area {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    align-self: stretch;
    background-color: rgba(255,255,255,0.02);
    border-width: 1px;
    border-color: rgba(255,255,255,0.06);
    overflow: hidden;
}

.preview-image {
    flex-grow: 1;
    align-self: stretch;
    -unity-background-scale-mode: scale-to-fit;
}

#preview-rt-surface {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    display: none;
}

.info-panel {
    flex-basis: 300px;
    flex-shrink: 0;
    padding: 16px;
    background-color: rgba(255,255,255,0.03);
    border-width: 1px;
    border-color: rgba(255,255,255,0.08);
    flex-direction: column;
    gap: 0px;
}

.info-section-label {
    color: #5A6473;
    font-size: 9px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 2px;
}

.info-title {
    color: #FFFFFF;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 2px;
    margin-bottom: 0px;
}

.info-desc {
    color: #B0BCCC;
    font-size: 12px;
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 0px;
    opacity: 0.85;
}

.info-divider {
    height: 1px;
    background-color: rgba(255,255,255,0.07);
    margin-top: 14px;
    margin-bottom: 2px;
}

.info-stat-row {
    flex-direction: column;
    margin-top: 10px;
    gap: 4px;
}

.info-stat-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.info-stat-name {
    color: #5A6473;
    font-size: 9px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.info-stat-value {
    color: #5EE1A5;
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.stat-bar-track {
    height: 2px;
    background-color: rgba(255,255,255,0.07);
    border-radius: 1px;
}

.stat-bar-fill {
    height: 2px;
    background-color: #5EE1A5;
    border-radius: 1px;
    opacity: 0.65;
}

.info-best-time {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(255,255,255,0.07);
}

.info-best-time-label {
    color: #5A6473;
    font-size: 9px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.info-best-time-value {
    color: #FFFFFF;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}
