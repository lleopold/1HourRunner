/* ============================================================
   LOADING SCREEN
   ============================================================ */
.loading-root {
	flex-grow: 1;
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	background-color: #0D0F14;
	flex-direction: column;
	justify-content: center;
	align-items: center;
}

/* ============================================================
   SPINNER RING
   ============================================================ */
.spinner-ring {
	width: 64px;
	height: 64px;
	border-radius: 32px;
	border-width: 3px;
	border-color: rgba(94,225,165,0.15);
	border-top-color: #5EE1A5;
	border-right-color: rgba(94,225,165,0.5);
}
