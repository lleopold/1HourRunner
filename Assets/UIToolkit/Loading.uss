/* ============================================================
   LOADING SCREEN
   ============================================================ */
.loading-root {
	flex-grow: 1;
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	background-color: #0D0F14;
	flex-direction: column;
	justify-content: center;
	align-items: center;
}

/* ============================================================
   TOP ACCENT BAR
   ============================================================ */
.loading-accent-bar {
	position: absolute;
	top: 0; left: 0; right: 0;
	height: 3px;
	background-color: #5EE1A5;
}

/* ============================================================
   TITLE
   ============================================================ */
.loading-title-top {
	font-size: 48px;
	color: #FFFFFF;
	-unity-font-style: bold;
	letter-spacing: 8px;
	margin: 0;
	padding: 0;
	-unity-text-align: middle-center;
}

.loading-title-bottom {
	font-size: 48px;
	color: #5EE1A5;
	-unity-font-style: bold;
	letter-spacing: 8px;
	margin-top: -8px;
	padding: 0;
	-unity-text-align: middle-center;
}

/* ============================================================
   LOADING LABEL
   ============================================================ */
.loading-label {
	font-size: 13px;
	color: #5A6473;
	letter-spacing: 4px;
	-unity-font-style: italic;
	margin-top: 48px;
	margin-bottom: 20px;
	-unity-text-align: middle-center;
}

/* ============================================================
   PROGRESS BAR TRACK
   ============================================================ */
.loading-bar-track {
	width: 460px;
	height: 3px;
	background-color: rgba(255,255,255,0.08);
	border-radius: 2px;
	overflow: hidden;
}

/* ============================================================
   PROGRESS BAR FILL
   ============================================================ */
.loading-bar-fill {
	height: 100%;
	width: 0%;
	background-color: #5EE1A5;
	border-radius: 2px;
	transition-property: width;
	transition-duration: 0.15s;
}

/* ============================================================
   PERCENTAGE LABEL
   ============================================================ */
.loading-percent {
	font-size: 11px;
	color: rgba(94,225,165,0.6);
	letter-spacing: 2px;
	margin-top: 10px;
	-unity-text-align: middle-center;
}
