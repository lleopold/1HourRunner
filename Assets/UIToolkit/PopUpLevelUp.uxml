<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">
  <Style src="project://database/Assets/UIToolkit/LevelUpMenu.uss#LevelUpMenu" />
  <ui:VisualElement name="levelup_root" class="levelup-panel">
    <ui:Label text="Choose a Power-Up" class="levelup-title" />
    <ui:VisualElement name="choices" class="choices-row">

      <ui:Button name="btn_pwr1" class="choice">
        <ui:VisualElement name="icon_pwr1" class="choice__icon" />
        <ui:Label name="lab_pwr1" text="More Health" class="choice__title" />
        <ui:Label text="+25% max HP" class="choice__desc" />
      </ui:Button>

      <ui:Button name="btn_pwr2" class="choice">
        <ui:VisualElement name="icon_pwr2" class="choice__icon" />
        <ui:Label name="lab_pwr2" text="Faster Reload" class="choice__title" />
        <ui:Label text="-20% reload time" class="choice__desc" />
      </ui:Button>

      <ui:Button name="btn_pwr3" class="choice">
        <ui:VisualElement name="icon_pwr3" class="choice__icon" />
        <ui:Label name="lab_pwr3" text="Faster Running" class="choice__title" />
        <ui:Label text="+15% move speed" class="choice__desc" />
      </ui:Button>

    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
